#purpose is to count how many times the loop ran and how many items are in the list

#loop sum
count = 0
print('Before: ', count)
for i in [1, 2, 3, 4, 5]:
    count = count + i
    print(count, i)

print('====================================================================================')

#finding the average
count = 0
sum = 0
print('Before: ', count, sum)
for value in [1, 2, 3, 4, 5]:
    count = count + 1
    sum = sum + value
    print(count, sum, value)
print('After: ', count, sum, sum / count)

print('====================================================================================')

