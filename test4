while True:
    score = input("Enter Score: ")
    if score == 'exit':
        break

    try:
        score = float(score)
    except ValueError:
        print('Error: invalid value')
        continue

    if score < 0.0 or score > 1.0:
        print('Error: Score is out of range.')
    elif score >= 0.9:
        print('A')
    elif score >= 0.8:
        print('B')
    elif score >= 0.7:
        print('C')
    elif score >= 0.6:
        print('D')
    else:
        print('F')